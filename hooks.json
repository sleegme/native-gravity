{
  "native-gravity-zen-shell-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.gemini/config/plugins/native-gravity/hooks/zen-shell-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
