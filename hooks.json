{
  "universal-mutation-safety-boundary": {
    "PreToolUse": [
      {
        "matcher": "^run_command$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/shell-safety-guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(write_to_file|replace_file_content|multi_replace_file_content|write_file|edit_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/shell-safety-guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "zen-verification-boundary": {
    "PreToolUse": [
      {
        "matcher": "^run_command$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/zen-shell-guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(write_to_file|replace_file_content|multi_replace_file_content|write_file|edit_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/zen-shell-guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "observation-telemetry-boundary": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ./hooks/telemetry-guard.py --session-start",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/telemetry-guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
