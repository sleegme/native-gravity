#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cmd="${1:-help}"
shift || true

resolve_model() {
  local prefix="$1"
  agy models 2>&1 | awk '{print $1}' | grep "^${prefix}" | head -n1 || true
}

case "$cmd" in
  main)
    if ! command -v agy >/dev/null 2>&1; then
      echo "agy not found on PATH" >&2
      exit 127
    fi
    model="${OMA_MAIN_MODEL:-$(resolve_model 'claude-sonnet-4-6')}"
    if [[ -z "$model" ]]; then
      echo "No Claude Sonnet 4.6 model found. Set OMA_MAIN_MODEL to override." >&2
      exit 2
    fi
    exec agy --model "$model" --agent oma-main "$@"
    ;;
  packet)
    exec "$ROOT/scripts/build-review-packet.sh" "$@"
    ;;
  review)
    exec "$ROOT/scripts/review-pro.sh" "$@"
    ;;
  smoke)
    exec "$ROOT/scripts/smoke-test.sh" "$@"
    ;;
  install-dev)
    exec "$ROOT/scripts/install-dev.sh" "$@"
    ;;
  help|-h|--help)
    cat <<'EOF'
Usage: oma <command>

  main         Start oma-main with the current Claude Sonnet 4.6 slug
  packet       Build .oma/review-packet.md in the current git worktree
  review       Run the read-only final reviewer with Gemini 3.1 Pro High
  smoke        Check required models and custom-agent discovery; add --live for a tiny live probe
  install-dev  Symlink this checkout into the Antigravity CLI plugin path
EOF
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    exit 2
    ;;
esac
